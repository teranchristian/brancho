{
  "compilerOptions": {
     "baseUrl": "src",
    "paths": {
      "core/*": ["core/*"], 
      "handlers/*": ["handlers/*"], 
      "utils/*": ["utils/*"]
    },
    "target": "ES6",
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "removeComments": true,
    "outDir": "dist",
    "rootDir": "src",
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "experimentalDecorators": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
